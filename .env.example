# Copy this file to .env and fill in the blanks.
# Every key below is read by the code. .env itself is ignored by git and must stay that way.
GIT_STRIP_CANARY=
LICENSE_HOLDER=
# Only the exact word "live" turns live mode on. Leave this empty for development and tests.
FOTHERING_LIVE=
# The stack sets this on deployed functions.
FOTHERING_TABLE_NAME=
# The stack sets this on deployed functions.
FOTHERING_DLQ_URL=
# The stack sets this on deployed functions.
FOTHERING_ADDRESS_KEY_SECRET_ID=
# The stack sets this on the deployed detection function: the ARN of the agent runtime it invokes.
FOTHERING_AGENT_RUNTIME_ARN=
# The stack sets this on the deployed agent runtime only. Leave it empty everywhere else: the
# runtime then listens on loopback.
FOTHERING_DEPLOYED_RUNTIME=

# A rule for an output only the repo root receives starts with a slash, so a source folder of the
# same name deeper in the tree (a reports page, a coverage module) is never silently untracked.
# dist/, .astro/ and .wrangler/ stay unanchored because each workspace writes its own.
node_modules/
dist/
/coverage/
packages/*/coverage/
apps/*/coverage/
.astro/
.wrangler/
.env
.env.*
!.env.example
.dev.vars
cdk.out/
*.log
/.stryker-tmp/
/reports/
/.knip-report.json
/trivy-*.json

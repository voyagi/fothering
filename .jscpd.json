{
  "minTokens": 70,
  "minLines": 8,
  "threshold": 0,
  "reporters": ["console-full"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/cdk.out/**",
    "**/.astro/**",
    "**/.wrangler/**",
    "**/.git/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.d.ts",
    "**/*.md",
    "**/docs/**",
    "scripts/**",
    "package-lock.json"
  ]
}

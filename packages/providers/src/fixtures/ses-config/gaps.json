  "note": "The same reads as complete.json with two gaps: the identity example.com defaults to fothering-bulk, and fothering-bulk's only destination leaves out DELIVERY_DELAY.",
  "recordings": [
    {
      "operation": "ses.listEmailIdentities",
      "request": null,
      "response": ["example.com", "example.org"]
    },
    {
      "operation": "ses.getEmailIdentity",
      "request": "example.com",
      "response": "fothering-bulk"
    },
    {
      "operation": "ses.getEmailIdentity",
      "request": "example.org"
    },
    {
      "operation": "ses.getConfigurationSetEventDestinations",
      "request": "fothering-transactional",
      "response": [
        {
          "name": "to-eventbridge",
          "enabled": true,
          "eventBridge": true,
          "matchingEventTypes": ["SEND", "REJECT", "BOUNCE", "COMPLAINT", "DELIVERY", "DELIVERY_DELAY"]
        }
      ]
    },
    {
      "operation": "ses.getConfigurationSetEventDestinations",
      "request": "fothering-bulk",
      "response": [
        {
          "name": "to-eventbridge",
          "enabled": true,
          "eventBridge": true,
          "matchingEventTypes": ["SEND", "REJECT", "BOUNCE", "COMPLAINT", "DELIVERY"]
        }
      ]
    },
    {
      "operation": "ses.getConfigurationSetEventDestinations",
      "request": "fothering-alerts",
      "response": [
        {
          "name": "to-eventbridge",
          "enabled": true,
          "eventBridge": true,
          "matchingEventTypes": ["SEND", "REJECT", "BOUNCE", "COMPLAINT", "DELIVERY", "DELIVERY_DELAY"]
        }
      ]
    }
  ]

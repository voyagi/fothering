---
// A drawing's table. The first cell of every row is its row header; a cell may carry a state mark,
// whose name is always printed beside it (UI-SPEC section 7, StateMark). Text marks code spans with
// backticks, the way the replay view writes them, and each span renders as an identifier.
import Identifier from './Identifier.astro';

type Mark = 'open' | 'later';

interface Cell {
  text: string;
  mark?: Mark;
  attrs?: Record<string, string>;
}

interface Row {
  header: string;
  // A short state printed after the header, such as "unconfirmed" on a provider row.
  headerNote?: string;
  headerHref?: string;
  cells: readonly Cell[];
  attrs?: Record<string, string>;
}

interface Props {
  columns: readonly string[];
  rows: readonly Row[];
  // Column indexes hidden at 620px and below.
  narrowHidden?: readonly number[];
  // Column indexes set in mono, 0 being the row header.
  monoColumns?: readonly number[];
  caption?: string;
  captionAttrs?: Record<string, string>;
  variant?: 'schedule' | 'ruled';
  // The replay's evidence; where its panel is narrow each row's header spans the row.
  compact?: boolean;
  // One block per row at 960px and below, each cell under its column name.
  stack?: boolean;
  // Column indexes whose API names may break between their capitalised words (the replay log's
  // Detail column only, UI-SPEC line 208).
  wordColumns?: readonly number[];
}

const { columns, rows, narrowHidden = [], monoColumns = [], caption, captionAttrs = {}, variant = 'schedule', compact = false, stack = false, wordColumns = [] } = Astro.props;
const classes = (column: number): string | undefined =>
  [narrowHidden.includes(column) ? 'hide-narrow' : '', monoColumns.includes(column) ? 'mono' : ''].filter((name) => name !== '').join(' ') || undefined;
// A column header is a label like its siblings; only the column's values are set in mono.
const headClass = (column: number): string | undefined => (narrowHidden.includes(column) ? 'hide-narrow' : undefined);
const tableClass = [variant, compact ? 'compact' : '', stack ? 'stack' : ''].filter((name) => name !== '').join(' ');
// display: block or grid drops table semantics in some engines, so a table that stacks or whose rows
// become grids states its roles.
type TableRole = 'table' | 'rowgroup' | 'row' | 'columnheader' | 'rowheader' | 'cell';
const role = (name: TableRole): TableRole | undefined => (stack || compact ? name : undefined);
const spans = (text: string): string[] => text.split('`');
---
<table class={tableClass} role={role('table')}>
  {caption !== undefined && <caption {...captionAttrs}>{caption}</caption>}
  <thead role={role('rowgroup')}>
    <tr role={role('row')}>{columns.map((column, index) => <th scope="col" class={headClass(index)} role={role('columnheader')}>{column}</th>)}</tr>
  </thead>
  <tbody role={role('rowgroup')}>
    {rows.map((row) => (
      <tr {...row.attrs} role={role('row')}>
        <th scope="row" class={classes(0)} role={role('rowheader')}>
          {row.headerHref === undefined
            ? spans(row.header).map((part, index) => (index % 2 === 1 ? <Identifier value={part} /> : part))
            : <a href={row.headerHref}>{spans(row.header).map((part, index) => (index % 2 === 1 ? <Identifier value={part} /> : part))}</a>}
          {row.headerNote !== undefined && <Fragment> <span class="note">{row.headerNote}</span></Fragment>}
        </th>
        {row.cells.map((cell, index) => (
          <td class={classes(index + 1)} data-col={stack ? columns[index + 1] : undefined} role={role('cell')} {...cell.attrs}>
            {cell.mark === undefined ? <span class="cell-text">{spans(cell.text).map((part, spanIndex) => (spanIndex % 2 === 1 ? <Identifier value={part} words={wordColumns.includes(index + 1)} /> : part))}</span> : (
              <span class="state">
                <svg class={`state-mark state-mark-${cell.mark}`} viewBox="0 0 12 12" aria-hidden="true"><rect x="1" y="1" width="10" height="10" /></svg>
                {cell.text}
              </span>
            )}
          </td>
        ))}
      </tr>
    ))}
  </tbody>
</table>

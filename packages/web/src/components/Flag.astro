---
// One flag of the International Code of Signals, drawn the way the NOAA signal sheet draws it.
// Every part is a polygon already cut to the flag's outline, so no clip path id repeats when a page
// flies the same flag twice. Fills come from classes, so the codified colours hold in both themes,
// and the flag is hidden from assistive technology because its letter or name and its meaning always
// sit beside it as text. The site flies two flags only: the numeral pennants were dropped because
// several read as national flags (1 as Japan's, 3 as France's, 4 as Switzerland's).
type FlagCode = 'L' | 'answer';
type Fill = 'red' | 'yellow' | 'blue' | 'black' | 'white';

interface Props {
  code: FlagCode;
  class?: string;
}

interface Shape {
  points: string;
  fill: Fill;
}

const { code, class: extra } = Astro.props;

// Pennants sit in a 125 by 50 box and taper to 18 units at the fly.
const W = 125;
const H = 50;
const TAPER = 18;
const round = (value: number): number => Math.round(value * 100) / 100;
const top = (x: number): number => round((TAPER * x) / W);
const bottom = (x: number): number => round(H - (TAPER * x) / W);
// A vertical band of the pennant between two distances from the hoist.
const band = (x0: number, x1: number): string => `${x0},${top(x0)} ${x1},${top(x1)} ${x1},${bottom(x1)} ${x0},${bottom(x0)}`;
const PENNANT = band(0, W);

// The answering pennant: five vertical stripes, red, white, red, white, red.
const ANSWER: readonly Shape[] = [0, 25, 50, 75, 100].map((x, index) => ({ points: band(x, x + 25), fill: index % 2 === 0 ? 'red' : 'white' }));

// Flag L is quartered yellow and black, yellow in the upper hoist, on a 3 by 2 flag.
const LETTER_L: readonly Shape[] = [
  { points: '0,0 30,0 30,20 0,20', fill: 'yellow' },
  { points: '30,0 60,0 60,20 30,20', fill: 'black' },
  { points: '0,20 30,20 30,40 0,40', fill: 'black' },
  { points: '30,20 60,20 60,40 30,40', fill: 'yellow' },
];

const isLetter = code === 'L';
const shapes = isLetter ? LETTER_L : ANSWER;
const box = isLetter ? { width: 60, height: 40 } : { width: W, height: H };
const edge = isLetter ? '0,0 60,0 60,40 0,40' : PENNANT;
const classes = ['flag', isLetter ? 'flag-letter' : 'flag-pennant', extra].filter((name) => name !== undefined && name !== '').join(' ');
---
<svg class={classes} viewBox={`0 0 ${String(box.width)} ${String(box.height)}`} width={box.width} height={box.height} aria-hidden="true" focusable="false" data-flag={code}>
  {shapes.map((shape) => <polygon class={`f-${shape.fill}`} points={shape.points} />)}
  <polygon class="f-edge" points={edge} />
</svg>

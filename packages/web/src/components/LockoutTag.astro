---
import type { ReplayView } from '../site/replay-view.ts';
import Identifier from './Identifier.astro';

interface Props {
  tag: ReplayView['tag'];
  provenance: string;
  row: number;
  // The landing tag carries the evidence line; the replay shows the evidence beside its tag.
  evidence?: boolean;
  // The replay shows the field name alone, the landing its full path.
  readBack?: 'full' | 'field';
}

const { tag, provenance, row, evidence = false, readBack = 'full' } = Astro.props;
const readBackText = readBack === 'full' ? tag.readBack : tag.replayReadBack;
// The view writes the read-back as "<field path>: <value>, <time> UTC"; only the path is an identifier.
const split = readBackText.indexOf(': ');
const readBackField = split < 0 ? readBackText : readBackText.slice(0, split);
const readBackRest = split < 0 ? '' : readBackText.slice(split);
// Prose fields mark code spans with backticks; odd-numbered pieces are the spans.
const evidenceParts = tag.evidence.split('`');
---
<article class="tag" data-tag data-provenance={provenance} aria-label={`Lockout tag on the ${tag.lane} lane, ${tag.stamp.toLowerCase()}`}>
  <span class="tag-hole" aria-hidden="true"></span>
  <header>
    <b>{tag.legend}</b>
    <span class="tag-lane mono"><Identifier value={tag.lane} face="inherit" /></span>
    <span class="stamp">{tag.stamp}</span>
  </header>
  <dl>
    <dt>Cause</dt>
    <dd><Identifier value={tag.cause} /></dd>
    {evidence && (
      <Fragment>
        <dt>Evidence</dt>
        <dd>{evidenceParts.map((part, index) => (index % 2 === 1 ? <Identifier value={part} /> : part))}</dd>
      </Fragment>
    )}
    <dt>Read back</dt>
    <dd class="mono"><Identifier value={readBackField} />{readBackRest}</dd>
    <dt>Reopens</dt>
    <dd>{tag.reopens}</dd>
  </dl>
  <footer><span>{tag.number}</span><span>ROW {row}</span></footer>
</article>

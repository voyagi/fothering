---
// A notice is marked by the answering pennant at the dip: seen, not yet answered, the way what is not
// built yet waits. The run-in label is read before the sentence, so the notice never passes as an
// ordinary paragraph.
import Flag from './Flag.astro';

interface Props {
  label: string;
  text: string;
}

const { label, text } = Astro.props;
---
<div class="notice" role="note" data-notice>
  <span class="dip" aria-hidden="true"><Flag code="answer" /></span>
  <p><b>{label}</b> {text}</p>
</div>

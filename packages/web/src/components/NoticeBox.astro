---
// A notice is marked by an unlit lamp: what it names is not on yet. The run-in label is read before
// the sentence, so the notice never passes as an ordinary paragraph.
interface Props {
  label: string;
  text: string;
}

const { label, text } = Astro.props;
---
<div class="notice" role="note" data-notice>
  <span class="lamp" aria-hidden="true"></span>
  <p><b>{label}</b> {text}</p>
</div>

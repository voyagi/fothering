---
// An identifier may end a line only right after one of its dots (UI-SPEC section 6). Each dotted
// part is one unbreakable run, since a browser would otherwise break after the hyphens of a tag
// value such as batch=2026-10-14-b; the <wbr> after each dot is the only break, and a space inside
// a part (an SMTP code) is made non-breaking.
// With `words`, an API operation name with no dot (PutConfigurationSetSendingOptions) may also end
// a line between its capitalised words, each word one unbreakable run with no hyphen added, and an
// IAM action after its colon too (ses: then GetConfigurationSetEventDestinations). Only the replay
// log's Detail cells (UI-SPEC line 208) and the permission schedules' Action cells (section 17
// item 2) pass it; the built rule identifier-break fails that break anywhere else.
// With face="inherit" the identifier keeps the face of the text around it, as the comp sets a
// configuration set name in running text, and only never breaks mid-name.
interface Props {
  value: string;
  words?: boolean;
  face?: 'mono' | 'inherit';
}

const NO_BREAK_SPACE = String.fromCharCode(0xa0);
const { value, words = false, face = 'mono' } = Astro.props;
const wordParts = words && !value.includes('.') ? value.split(/(?=[A-Z])/) : [];
const byWords = wordParts.length > 1;
const parts = byWords ? wordParts : value.split('.').map((part) => part.replaceAll(' ', NO_BREAK_SPACE));
// Each part with its joiner, and whether a break may follow it.
const runs = parts.map((part, index) => ({ text: index < parts.length - 1 ? `${part}${byWords ? '' : '.'}` : part, breakAfter: index < parts.length - 1 }));
---
{face === 'inherit'
  ? <span class="identifier" data-identifier data-identifier-face="inherit">{runs.map((run) => (run.breakAfter ? <Fragment><span>{run.text}</span><wbr /></Fragment> : <span>{run.text}</span>))}</span>
  : <code class="identifier" data-identifier data-identifier-words={byWords ? '' : undefined}>{runs.map((run) => (run.breakAfter ? <Fragment><span>{run.text}</span><wbr /></Fragment> : <span>{run.text}</span>))}</code>}

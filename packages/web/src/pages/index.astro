---
import { parseLaneMap } from '@fothering/core/lanes';
import Sheet from '../layouts/Sheet.astro';
import { readRepoText, repoRoot } from '../site/repo-facts.ts';
import { routeFor } from '../site/route-list.ts';

const laneMap = parseLaneMap(JSON.parse(readRepoText('lanes.json', repoRoot(process.cwd()))));
const configurationSets = laneMap.lanes.map((lane) => lane.configurationSet);
---
<Sheet route={routeFor('/')}>
  <h1>Fothering</h1>
  <ul>
    {configurationSets.map((name) => <li>{name}</li>)}
  </ul>
</Sheet>

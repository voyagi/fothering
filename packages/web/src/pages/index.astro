---
import Flag from '../components/Flag.astro';
import Identifier from '../components/Identifier.astro';
import Procedure from '../components/Procedure.astro';
import Schedule from '../components/Schedule.astro';
import Sheet from '../layouts/Sheet.astro';
import { LANDING_SECTIONS, LIMITS_FIXED_ROWS, LIMITS_REPLAY_ROW, NO_MEASURED_NUMBER_SENTENCE, type LandingSectionId } from '../site/content.ts';
import { textSegments, type Segment } from '../site/identifier-text.ts';
import { PROVENANCE_LABELS } from '../site/labels.ts';
import { readDeployRegion, repoRoot } from '../site/repo-facts.ts';
import { buildReplayView, loadReplayArtifact } from '../site/replay-view.ts';
import { routeFor } from '../site/route-list.ts';

// The Region comes from the stacks' pin, as on the deploy and privacy pages, never typed here.
const region = readDeployRegion(repoRoot(process.cwd()));
const artifact = loadReplayArtifact(process.cwd());
const view = buildReplayView(artifact);
const label = PROVENANCE_LABELS[artifact.provenance];
const heading = (id: LandingSectionId): string => LANDING_SECTIONS.find((section) => section.id === id)?.heading ?? '';
const openLanes = artifact.lanes.filter((lane) => lane !== artifact.closedLane);
const terms = view.identifierTerms;

// The view writes the read-back as "<field>: <value>, <time> UTC"; only the field is an identifier.
const readBackText = view.tag.replayReadBack;
const readBackSplit = readBackText.indexOf(': ');
const readBackField = readBackSplit < 0 ? readBackText : readBackText.slice(0, readBackSplit);
const readBackRest = readBackSplit < 0 ? '' : readBackText.slice(readBackSplit);
// Committed solid, alternatives in outline: the cause row is the one filled mark, and every other
// evidence row is the same mark in outline.
const ruledOut = view.schedule.rows.filter((row) => row.verdict !== 'Cause');
const faceOf = (segment: Segment): 'mono' | 'inherit' => (segment.kind === 'name' ? 'inherit' : 'mono');

const steps = [
  { title: 'Watch every event', text: 'Sends, deliveries, bounces, complaints, rejects and delays arrive through EventBridge, grouped by configuration set and by your message tags.' },
  { title: 'Name the cause, or say unknown', text: 'Detection code traces a spike to one import batch, template, receiving provider or missing authentication record, with the events that show it.' },
  {
    title: 'Close one lane, then read it back',
    text: `Sending is switched off for that configuration set only, then confirmed through a second call, like flag L on ${artifact.closedLane} above.`,
    provenance: artifact.provenance,
  },
  { title: 'Tell you by email', text: 'You get what it saw, what it closed, what stays open, and the command that reopens the lane. Nothing reopens until you run it.' },
];

const refusals = [
  'Close a lane on a guess. When the evidence does not settle the cause, nothing closes, and the email says what code found.',
  'Pause your whole account. The smallest closure that stops the damage is one configuration set.',
  'Reopen on its own, or report a closure the read-back did not confirm. A lane reopens only when you run the reopen command.',
  `Keep recipient addresses. Event records hold the receiving domain and a keyed hash, in ${region}, and expire 30 days after the send; deletion follows within a few days.`,
];
// The refusal is its first sentence and the reason the rest, split so the text reads unchanged.
const refusalParts = refusals.map((refusal) => {
  const end = refusal.indexOf('. ') + 1;
  return { refusal: refusal.slice(0, end), reason: refusal.slice(end + 1) };
});

const limitsRows = [
  {
    header: LIMITS_REPLAY_ROW.part,
    attrs: { 'data-limits-row': LIMITS_REPLAY_ROW.id, 'data-provenance': artifact.provenance },
    cells: [{ text: label.limitsState, mark: label.limitsMark, attrs: { 'data-limits-state': '' } }, { text: label.limitsNote }],
  },
  ...LIMITS_FIXED_ROWS.map((row) => ({
    header: row.part,
    attrs: { 'data-limits-row': row.id },
    cells: [{ text: row.state, mark: row.mark, attrs: { 'data-limits-state': '' } }, { text: row.note }],
  })),
];
---
<Sheet route={routeFor('/')}>
  <section class="first-band" aria-labelledby="moment-title">
    <div class="claim">
      <h1 id="moment-title" class="landing-title">{heading('moment')}</h1>
      <p class="lede" data-lede data-model-role>Fothering reads the events your Amazon SES configuration sets publish. When one stream starts damaging the reputation they share, its code pauses that one configuration set, reads the setting back, and tells you by email. An agent on Amazon Bedrock AgentCore explains the evidence, and can only confirm the lane code approved or say unknown.</p>
      <div class="actions">
        <a class="flagbtn" href="/replay/">Replay the incident
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h9M8.5 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" /></svg>
        </a>
        <a class="textlink" href="/deploy/">Deploy into your AWS account</a>
      </div>
    </div>
    <figure class="sea sea-col" data-tag data-provenance={artifact.provenance} aria-label={view.landing.drawingTitle} aria-describedby="landing-desc">
      <p id="landing-desc" class="visually-hidden">{view.landing.drawingDescription}</p>
      <div class="hoist hoist-answer">
        <Flag code="answer" />
        <div class="decode">
          <p class="k">Answering pennant, close up</p>
          <p class="v">Read back</p>
          <p class="v"><Identifier value={readBackField} />{readBackRest}</p>
        </div>
      </div>
      <div class="hoist">
        <Flag code="L" />
        <div class="decode">
          <p class="letter"><span class="visually-hidden">Flag </span>L</p>
          <p class="meaning">You should stop your vessel instantly.</p>
          <p class="legend">{view.tag.legend}</p>
          <p class="lane"><Identifier value={view.tag.lane} /></p>
          <p class="stamp" data-provenance={artifact.provenance}>{view.tag.stamp}</p>
        </div>
      </div>
      <dl class="book">
        <div>
          <dt>Cause</dt>
          <dd><svg class="sq sq-solid" viewBox="0 0 12 12" aria-hidden="true"><rect x="1" y="1" width="10" height="10" /></svg><Identifier value={view.tag.cause} /></dd>
        </div>
        <div>
          <dt>Evidence</dt>
          <dd>{textSegments(view.tag.evidence, terms).map((segment) => (segment.kind === 'text' ? segment.text : <Identifier value={segment.text} face={faceOf(segment)} />))}</dd>
        </div>
        {ruledOut.length > 0 && (
          <div>
            <dt>Ruled out</dt>
            <dd>
              <ul>
                {ruledOut.map((row) => (
                  <li><svg class="sq" viewBox="0 0 12 12" aria-hidden="true"><rect x="1" y="1" width="10" height="10" /></svg>{textSegments(row.label, terms).map((segment) => (segment.kind === 'text' ? segment.text : <Identifier value={segment.text} face={faceOf(segment)} />))}</li>
                ))}
              </ul>
            </dd>
          </div>
        )}
        <div>
          <dt>Reopens</dt>
          <dd>{view.tag.reopens}</dd>
        </div>
      </dl>
      {openLanes.length > 0 && (
        <ul class="quiet-lanes">
          {openLanes.map((lane) => <li><Identifier value={lane} /> Open, no signal.</li>)}
        </ul>
      )}
      <figcaption class="caption" data-provenance={artifact.provenance}>{view.caption}{view.captionLinkHref !== undefined && <Fragment> <a href={view.captionLinkHref}>How SES counts reputation</a></Fragment>}</figcaption>
    </figure>
  </section>

  <section class="band band-split" aria-labelledby="procedure-title">
    <div class="band-intro">
      <h2 id="procedure-title">{heading('procedure')}</h2>
      <p>The order is fixed, the way an isolation procedure is. A step that cannot finish stops the sequence and closes nothing.</p>
    </div>
    <Procedure steps={steps} />
  </section>

  <section class="band band-split refusals" aria-labelledby="refusals-title">
    <div class="band-intro">
      <h2 id="refusals-title">{heading('refusals')}</h2>
    </div>
    <ul class="refuse">
      {refusalParts.map((part) => <li><b>{part.refusal}</b> <span>{part.reason}</span></li>)}
    </ul>
  </section>

  <section class="band" aria-labelledby="limits-title" data-limits>
    <div class="band-head">
      <h2 id="limits-title">{heading('limits')}</h2>
      <p>This is a hackathon build. {NO_MEASURED_NUMBER_SENTENCE}</p>
    </div>
    <Schedule variant="ruled" columns={['Part', 'State', 'Note']} narrowHidden={[2]} rows={limitsRows} />
  </section>

  <section class="close-band sea" aria-labelledby="close-title">
    <div>
      <h2 id="close-title">Watch it close one lane</h2>
      <p>The replay plays in this browser. Nothing to install, no AWS account needed.</p>
    </div>
    <a class="flagbtn" href="/replay/">Replay the incident
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h9M8.5 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" /></svg>
    </a>
  </section>
</Sheet>

---
import CommandBlock from '../components/CommandBlock.astro';
import Identifier from '../components/Identifier.astro';
import NoticeBox from '../components/NoticeBox.astro';
import Procedure from '../components/Procedure.astro';
import Schedule from '../components/Schedule.astro';
import Sheet from '../layouts/Sheet.astro';
import { DEPLOY_COPY, NOT_YET_NOTICE, ONE_CALLER_SENTENCE, PERMISSION_COLUMNS, RESOURCE_COLUMNS, RESOURCE_REMOVAL } from '../site/content.ts';
import { textSegments } from '../site/identifier-text.ts';
import { denyRows, hasPauseGrant, loadPermissionSnapshot, permissionKey, permissionSchedules, runtimeRoleHoldsNoDataAction } from '../site/permissions-view.ts';
import { deploySteps, fillRegion, loadRepoFacts, readDeployRegion, removalSteps, repoRoot } from '../site/repo-facts.ts';
import { loadResourceSnapshot, resourceRows } from '../site/resources-view.ts';
import { routeFor } from '../site/route-list.ts';

// Every table, command and the Region come from the committed sources on each build, so the sheet
// follows the template with no edit here (D-142, D-143, D-145).
const root = repoRoot(process.cwd());
const facts = loadRepoFacts(root);
const region = readDeployRegion(root);
const snapshot = loadPermissionSnapshot(root);
const steps = deploySteps({ deployCommands: facts.deployCommands, region });
const removal = removalSteps(facts);
const destroyCommands = (removal[0]?.commands ?? []).map(({ command }) => command);

type PermissionRow = ReturnType<typeof permissionSchedules>[number]['rows'][number];
const roleNameOf = (row: PermissionRow): string => permissionKey(row).split('/')[1] ?? row.role;
const permissionCells = (row: PermissionRow) => [
  { text: `\`${row.action}\`` },
  { text: row.effect },
  { text: row.resourceOrPrincipal, long: true },
  { text: row.condition, long: true },
  { text: row.reason },
];
// Deny rows sit in the Deny box alone, so every snapshot entry renders exactly once (AC-33).
const roles = permissionSchedules(snapshot).flatMap((schedule) => {
  const allowed = schedule.rows.filter((row) => row.effect !== 'Deny');
  const [first] = allowed;
  if (first === undefined) return [];
  return [{
    id: `${schedule.stack}/${roleNameOf(first)}`,
    name: roleNameOf(first),
    stack: schedule.stack,
    rows: allowed.map((row) => ({ header: row.kind, attrs: { 'data-permission': permissionKey(row) }, cells: permissionCells(row) })),
  }];
});
const denied = denyRows(snapshot).map((row) => ({
  header: roleNameOf(row),
  attrs: { 'data-permission': permissionKey(row) },
  cells: [{ text: row.kind }, ...permissionCells(row)],
}));

const resources = resourceRows(loadResourceSnapshot(root)).map((row) => ({
  header: `\`${row.logicalId}\``,
  attrs: { 'data-resource': `${row.stack}/${row.logicalId}` },
  cells: [
    { text: row.noun },
    { text: `\`${row.stack}\`` },
    row.deletedOnRemoval ? { text: RESOURCE_REMOVAL.deleted, commands: destroyCommands } : { text: RESOURCE_REMOVAL.kept },
  ],
}));

const NO_TERMS = { names: [], values: [] };
const intro = textSegments(fillRegion(DEPLOY_COPY.intro, region), NO_TERMS);
---
<Sheet route={routeFor('/deploy/')}>
  <div class="row">
    <div class="rail" aria-hidden="true">1</div>
    <section class="sheet-intro" aria-labelledby="deploy-title">
      <h1 id="deploy-title">{DEPLOY_COPY.h1}</h1>
      <p>{intro.map((segment) => (segment.kind === 'text' ? segment.text : <Identifier value={segment.text} />))}</p>
      {!hasPauseGrant(snapshot) && <NoticeBox label={NOT_YET_NOTICE.label} text={NOT_YET_NOTICE.text} />}
    </section>
  </div>

  <div class="row">
    <div class="rail" aria-hidden="true">2</div>
    <section class="sheet" aria-labelledby="steps-title">
      <div class="sheet-head">
        <h2 id="steps-title">{DEPLOY_COPY.stepsHeading}</h2>
        <p>{DEPLOY_COPY.stepsHead}</p>
      </div>
      <Procedure steps={steps} closingStep={steps.length} />
    </section>
  </div>

  <div class="row">
    <div class="rail" aria-hidden="true">3</div>
    <section class="sheet fit-resources" aria-labelledby="resources-title">
      <div class="sheet-head">
        <h2 id="resources-title">{DEPLOY_COPY.resourcesHeading}</h2>
        <p>{DEPLOY_COPY.resourcesHead}</p>
      </div>
      <Schedule fit columns={RESOURCE_COLUMNS} rows={resources} caption={fillRegion(DEPLOY_COPY.resourcesCaption, region)} />
    </section>
  </div>

  <div class="row">
    <div class="rail" aria-hidden="true">4</div>
    <section class="sheet fit-permissions" aria-labelledby="permissions-title">
      <div class="sheet-head">
        <h2 id="permissions-title">{DEPLOY_COPY.permissionsHeading}</h2>
        <p>{DEPLOY_COPY.permissionsHead}</p>
      </div>
      <div class="roles">
        {roles.map((role) => (
          <section class="role" data-permission-role={role.id} aria-labelledby={`role-${role.name}`}>
            <div class="role-head">
              <h3 id={`role-${role.name}`}>{role.name}</h3>
              <p class="role-stack"><span>Stack</span> <Identifier value={role.stack} /></p>
            </div>
            <Schedule fit columns={PERMISSION_COLUMNS} rows={role.rows} caption={DEPLOY_COPY.permissionsCaption} />
          </section>
        ))}
      </div>
      <div class="perm-notes">
        <p>{ONE_CALLER_SENTENCE}</p>
        {runtimeRoleHoldsNoDataAction(snapshot) && <p>{DEPLOY_COPY.runtimeRoleSentence}</p>}
      </div>
      {denied.length > 0 && (
        <div class="deny" data-deny>
          <h3>{DEPLOY_COPY.denyHeading}</h3>
          <Schedule fit columns={['Role', ...PERMISSION_COLUMNS]} rows={denied} caption={DEPLOY_COPY.permissionsCaption} />
        </div>
      )}
    </section>
  </div>

  <div class="row">
    <div class="rail" aria-hidden="true">5</div>
    <section class="sheet" aria-labelledby="removal-title">
      <div class="sheet-head">
        <h2 id="removal-title">{DEPLOY_COPY.removalHeading}</h2>
        <p>{DEPLOY_COPY.removalHead}</p>
      </div>
      <ol class="removal">
        {removal.map((step) => (
          <li>
            <div>
              <p>{step.text}</p>
              {step.commands.map((command) => <CommandBlock command={command.command} note={command.note} />)}
            </div>
          </li>
        ))}
      </ol>
    </section>
  </div>
</Sheet>

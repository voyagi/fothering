---
import { PROVENANCE_LABELS } from '../site/labels.ts';
import { loadReplayArtifact } from '../site/replay-view.ts';
import { headMeta, ROUTES, type SheetRoute } from '../site/route-list.ts';
import { HEAD_SCRIPT } from '../theme/head-script.ts';
import '../styles/site.css';

interface Props {
  route: SheetRoute;
}

const { route } = Astro.props;
const head = headMeta(route);

// The revision is committed, never read from the build clock, so two builds of one commit match.
// The date is kept whole; the line may end after the mark.
const REVISION = { mark: 'Rev A', date: '2026-10-17' };
const ZONES = ['A', 'B', 'C', 'D', 'E', 'F'];
const THEMES = [
  { value: 'device', label: 'Device' },
  { value: 'light', label: 'Light' },
  { value: 'dark', label: 'Dark' },
];
// Working sheets and reading sheets sit in separate title block cells, as on the approved comp.
const READING_PATHS = new Set(['/privacy-and-ai/', '/accessibility/']);
const workingSheets = ROUTES.filter((entry) => !READING_PATHS.has(entry.path));
const readingSheets = ROUTES.filter((entry) => READING_PATHS.has(entry.path));
const sheetIndex = ROUTES.findIndex((entry) => entry.path === route.path);
const drawing = route.path === null ? route.drawing : `${route.sheet}, sheet ${sheetIndex + 1} of ${ROUTES.length}`;
const status = PROVENANCE_LABELS[loadReplayArtifact(process.cwd()).provenance].titleBlockStatus;
const currentMark = (path: string): 'page' | undefined => (path === route.path ? 'page' : undefined);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline set:html={HEAD_SCRIPT}></script>
    <link rel="stylesheet" href="/tokens.css" />
    <title>{head.title}</title>
    {head.metas.map((attrs) => <meta {...attrs} />)}
    {head.links.map((attrs) => <link {...attrs} />)}
    <script>
      import '../client/chrome.ts';
    </script>
  </head>
  <body>
    <div class="frame">
      <a class="skip" href="#main">Skip to main content</a>
      <div class="zones" aria-hidden="true">
        <span></span>
        {ZONES.map((zone) => <span>{zone}</span>)}
      </div>
      <header class="bar">
        <a class="wordmark" href="/">FOTHERING</a>
        <div class="bar-end">
          <a class="bar-link" href="#index">Sheet index</a>
          <fieldset class="theme">
            <legend>Colour theme</legend>
            {THEMES.map((theme) => (
              <label>
                <input type="radio" name="theme" value={theme.value} checked={theme.value === 'device'} />
                <span>{theme.label}</span>
              </label>
            ))}
          </fieldset>
        </div>
      </header>
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <footer id="index" class="titleblock">
        <div>
          <b>Project</b>
          Fothering. Stops one leak without stopping the ship.
        </div>
        <nav aria-label="Sheets">
          <b>Sheets</b>
          <ul>
            {workingSheets.map((entry) => <li><a href={entry.path} aria-current={currentMark(entry.path)}>{entry.label}</a></li>)}
          </ul>
        </nav>
        {readingSheets.length > 0 && (
          <div>
            <b>Read</b>
            <ul>
              {readingSheets.map((entry) => <li><a href={entry.path} aria-current={currentMark(entry.path)}>{entry.label}</a></li>)}
            </ul>
          </div>
        )}
        <div>
          <b>Drawing</b>
          <span class="mono">{drawing}</span><br />
          <span class="mono">{REVISION.mark}, <span class="keep-whole">{REVISION.date}</span></span><br />
          <span class="mono">Status: {status}</span>
        </div>
      </footer>
    </div>
  </body>
</html>

---
import { PROVENANCE_LABELS } from '../site/labels.ts';
import { loadReplayArtifact } from '../site/replay-view.ts';
import { headMeta, ROUTES, type SheetRoute } from '../site/route-list.ts';
import { HEAD_SCRIPT } from '../theme/head-script.ts';
import '../styles/site.css';
import publicSansLatin from '@fontsource-variable/public-sans/files/public-sans-latin-wght-normal.woff2?url';
import sairaLatin from '@fontsource-variable/saira/files/saira-latin-wdth-normal.woff2?url';
import sourceCodeProLatin from '@fontsource-variable/source-code-pro/files/source-code-pro-latin-wght-normal.woff2?url';

interface Props {
  route: SheetRoute;
}

const { route } = Astro.props;
const head = headMeta(route);

const THEMES = [
  { value: 'device', label: 'Device' },
  { value: 'light', label: 'Light' },
  { value: 'dark', label: 'Dark' },
];
// The top strip names the three working pages; the index at the foot names all five.
const STRIP_PATHS = ['/replay/', '/deploy/', '/privacy-and-ai/'];
const stripRoutes = STRIP_PATHS.map((path) => ROUTES.find((entry) => entry.path === path)).filter((entry) => entry !== undefined);
const { provenance } = loadReplayArtifact(process.cwd());
const status = PROVENANCE_LABELS[provenance].titleBlockStatus;
const currentMark = (path: string): 'page' | undefined => (path === route.path ? 'page' : undefined);
// The faces swap in, so a latin face found only once site.css has been parsed lands after the
// first paint and reflows the first band (layout shift about 0.2 on /deploy/ and /replay/).
// Preloaded, the three are fetched beside the stylesheet.
const PRELOADED_FACES = [sairaLatin, publicSansLatin, sourceCodeProLatin];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline set:html={HEAD_SCRIPT}></script>
    <link rel="stylesheet" href="/tokens.css" />
    {PRELOADED_FACES.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <title>{head.title}</title>
    {head.metas.map((attrs) => <meta {...attrs} />)}
    {head.links.map((attrs) => <link {...attrs} />)}
    <script>
      import '../client/chrome.ts';
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>
    <header class="top-strip">
      <a class="wordmark" href="/">FOTHERING</a>
      <nav aria-label="Main">
        <ul>
          {stripRoutes.map((entry) => <li><a href={entry.path} aria-current={currentMark(entry.path)}><span class="lamp" aria-hidden="true"></span>{entry.label}</a></li>)}
        </ul>
      </nav>
      <fieldset class="theme">
        <legend>Colour theme</legend>
        {THEMES.map((theme) => (
          <label>
            <input type="radio" name="theme" value={theme.value} checked={theme.value === 'device'} />
            <span><span class="lamp" aria-hidden="true"></span><span class="cap" aria-hidden="true"></span>{theme.label}</span>
          </label>
        ))}
      </fieldset>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="index">
      <p class="project">Fothering. Stops one leak without stopping the ship.</p>
      <nav aria-label="Every page">
        <ul>
          {ROUTES.map((entry) => <li><a href={entry.path} aria-current={currentMark(entry.path)}>{entry.label}</a></li>)}
        </ul>
      </nav>
      <p class="status" data-provenance={provenance}>Replay data: {status}</p>
    </footer>
  </body>
</html>
